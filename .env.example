# Copy to .env.local for local development (never commit real values).

# Neon Postgres connection string (sslmode=require is enforced in code).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# 32 random bytes, base64:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP A BACKUP - losing this key makes all encrypted client data and chat unreadable.
DATA_ENCRYPTION_KEY=

# 32+ random characters used to sign session cookies.
AUTH_SECRET=

# Email (Gmail App Password: https://myaccount.google.com/apppasswords)
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM="CoachFlow <you@gmail.com>"
# Optional
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# APP_URL=https://coachflow.pro   (links in emails; defaults to the address the request came from)
# APP_TZ=Asia/Singapore

# AI workout reading (Groq API key from console.groq.com). Optional: without it the importer uses the built-in reader.
GROQ_API_KEY=
# Optional: several keys (comma separated) share the AI load; a busy or rejected key is skipped automatically.
GROQ_API_KEYS=

# Google Maps / Places API key for location search (browser key: restrict it to your site's domain in Google Cloud).
# Enable "Places API (New)". Without a key, location fields become plain text boxes.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: set to "google" after enabling the Maps Embed API for the key, to show Google's map instead of the free OpenStreetMap preview.
# NEXT_PUBLIC_MAPS_EMBED=google

# Sign-up bot check (Cloudflare Turnstile, free). Optional: without keys there is no CAPTCHA and the rate limits and email confirmation do the work.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Set to 1 to lock out a self sign-up whose 30-day free trial is over. Leave empty until paid plans are live.
# TRIAL_ENFORCED=1
# --- Subscriptions (Stripe, Singapore dollars). See docs/STRIPE-SETUP.md for where to find each value.
STRIPE_SECRET_KEY=            # sk_test_... (test mode) while building; sk_live_... when you go live
STRIPE_WEBHOOK_SECRET=        # whsec_... (from the webhook you register; see npm run stripe:setup -- --webhook <url>)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   (not needed: payment happens on Stripe's own checkout page)
BILLING_ENFORCED=             # set to 1 to require a trial / subscription. Leave empty until you are ready to charge.
STRIPE_TAX=                   # set to 1 once Stripe Tax is active for Singapore GST (adds GST at checkout)
CRON_SECRET=                  # any long random text; Vercel Cron sends it to the daily trial-reminder job

# --- Payments between coaches and clients (Stripe Connect; see docs/PAYMENTS-SETUP.md). CoachFlow takes 0%. Uses the same STRIPE_SECRET_KEY as above.
STRIPE_CONNECT_WEBHOOK_SECRET=      # whsec_... of the webhook that listens to events on Connected accounts
CONNECT_ENABLED=                    # set to 1 once Stripe Connect is enabled on your Stripe account; until then coaches only get PayNow and cash

# --- Phone notifications (Web Push). Make the pair once with: npx web-push generate-vapid-keys. Without them the Notifications page says it is not switched on yet.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=       # keep secret; Vercel only (sensitive)
VAPID_SUBJECT=mailto:you@example.com
